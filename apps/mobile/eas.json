{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "resourceClass": "large",
        "env": {
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "internal",
      "android": {
        "resourceClass": "large"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "resourceClass": "large"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
