{
  "expo": {
    "name": "Ember",
    "slug": "ember",
    "description": "5ch.io 専用の掲示板ブラウザ",
    "scheme": "ember",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "primaryColor": "#f54011",
    "backgroundColor": "#0b0d12",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 10000,
      "url": "https://u.expo.dev/53f5eb87-33cf-4eee-835a-77cce26f4151"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.votepurchase.ember",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Ember",
        "CFBundleDevelopmentRegion": "ja_JP"
      },
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "net.votepurchase.ember",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0b0d12"
      },
      "permissions": [
        "VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID",
        "VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0d12",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0b0d12"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "画像を投稿するときに写真を選ぶため、写真へのアクセスを求めます。",
          "savePhotosPermission": "スレッドの画像を端末に保存するため、写真へのアクセスを求めます。",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "この許可は使いません。広告も計測も行いません。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "53f5eb87-33cf-4eee-835a-77cce26f4151"
      }
    }
  }
}
