{
  "expo": {
    "name": "Ember",
    "slug": "ember",
    "description": "5ch.io 専用の掲示板ブラウザ",
    "scheme": "ember",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "primaryColor": "#f54011",
    "backgroundColor": "#0b0d12",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 10000,
      "url": "https://u.expo.dev/53f5eb87-33cf-4eee-835a-77cce26f4151"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.votepurchase.ember",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Ember",
        "CFBundleDevelopmentRegion": "ja_JP",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.kernel.extended-virtual-addressing": true,
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "net.votepurchase.ember",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0b0d12"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0d12",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0b0d12"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "画像を投稿するときに写真を選ぶため、写真へのアクセスを求めます。",
          "savePhotosPermission": "スレッドの画像を端末に保存するため、写真へのアクセスを求めます。",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-background-task",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "画像を投稿するときに写真を選ぶため、写真へのアクセスを求めます。",
          "cameraPermission": "投稿する写真の撮影と QR コードの読み取りのため、カメラへのアクセスを求めます。",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "投稿する写真の撮影と QR コードの読み取りのため、カメラへのアクセスを求めます。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "llama.rn",
      "expo-video",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "53f5eb87-33cf-4eee-835a-77cce26f4151",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "net.votepurchase.ember.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.net.votepurchase.ember"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
